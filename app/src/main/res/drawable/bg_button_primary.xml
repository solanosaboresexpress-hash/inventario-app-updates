<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_gold_light">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/brand_gold"
                android:endColor="@color/brand_gold_dark"
                android:type="linear"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="@color/brand_gold_light"/>
        </shape>
    </item>
</ripple>
