<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_menu_background">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar tipo de pedido"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/brand_white"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Opción 1: Pedido Fábrica -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPedidoFabrica"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="🏭 Pedido Fábrica" />

    <!-- Opción 2: Pedido Panificadora -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPedidoPanificadora"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="🥖 Pedido Panificadora" />

    <!-- Opción 3: Pedido Bebidas -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPedidoBebidas"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="🍺 Pedido Bebidas" />

    <!-- Opción 4: Pedido Papelería -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPedidoPapeleria"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="📄 Pedido Papelería" />

</LinearLayout>
