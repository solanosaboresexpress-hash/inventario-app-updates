<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header con información del local -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtLocalActual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Administración: Local Seleccionado"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:drawableStart="@android:drawable/ic_menu_preferences"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical|center_horizontal" />

                    <!-- Contenedor responsivo para estadísticas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false">

                        <!-- Documentos -->
                        <LinearLayout
                            android:id="@+id/cardDocumentos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/card_stat_background"
                            android:padding="12dp"
                            android:layout_marginHorizontal="4dp"
                            android:gravity="center"
                            android:minHeight="80dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📄"
                                android:textSize="24sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtTotalDocumentos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_success"
                                android:maxLines="1"
                                android:ellipsize="none" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Documentos"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:maxLines="1"
                                android:ellipsize="none" />

                        </LinearLayout>

                        <!-- Personal -->
                        <LinearLayout
                            android:id="@+id/cardPersonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/card_stat_background"
                            android:padding="12dp"
                            android:layout_marginHorizontal="4dp"
                            android:gravity="center"
                            android:minHeight="80dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥"
                                android:textSize="24sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtTotalPersonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_info"
                                android:maxLines="1"
                                android:ellipsize="none" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personal"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:maxLines="1"
                                android:ellipsize="none" />

                        </LinearLayout>

                        <!-- Alertas -->
                        <LinearLayout
                            android:id="@+id/cardAlertas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/card_stat_background"
                            android:padding="12dp"
                            android:layout_marginHorizontal="4dp"
                            android:gravity="center"
                            android:minHeight="80dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️"
                                android:textSize="24sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtAlertasActivas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_warning"
                                android:maxLines="1"
                                android:ellipsize="none" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alertas"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:maxLines="1"
                                android:ellipsize="none" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Contenedores de secciones -->
            <LinearLayout
                android:id="@+id/documentosContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/personalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/notificacionesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- FAB para agregar documentos -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAgregarDocumento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Agregar Documento"
        android:textColor="@color/brand_black"
        app:backgroundTint="@color/brand_gold"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/brand_black"
        android:visibility="gone" />

    <!-- FAB para agregar personal -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAgregarPersonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Agregar Personal"
        android:textColor="@color/brand_black"
        app:backgroundTint="@color/brand_gold"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/brand_black"
        android:visibility="gone" />

</FrameLayout>
