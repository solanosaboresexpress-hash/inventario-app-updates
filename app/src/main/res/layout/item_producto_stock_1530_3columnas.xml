<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@drawable/product_item_background"
    android:layout_margin="2dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/layoutProductInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/txtCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JQ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Contenedor Horizontal de Badges para Evitar Superposiciones o Desbordes -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/badgeStockBajo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Bajo"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/badgeTendencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 10%"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/badgeVencimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 0u"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Stock 15:30 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="2dp"/>

        <EditText
            android:id="@+id/edtCantidad"
            android:inputType="number"
            android:hint="0"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:background="@drawable/edit_text_background"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="4dp"/>

    </LinearLayout>

    <!-- Sugerencia -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sugerencia"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/txtSugerencia"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:text="0"
            android:background="@drawable/edit_text_background"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="4dp"/>

    </LinearLayout>

    <!-- Pedido Final -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedido Final"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="2dp"/>

        <EditText
            android:id="@+id/edtPedido"
            android:inputType="number"
            android:hint="0"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:background="@drawable/edit_text_background"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="4dp"/>

    </LinearLayout>

</LinearLayout>