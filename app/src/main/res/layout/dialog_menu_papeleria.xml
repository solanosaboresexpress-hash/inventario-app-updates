<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_menu_background">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Módulo Papelería"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/brand_white"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Opción 1: Pedido Papelería (incluye stock) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPedidoPapeleria"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="📋 Pedido Papelería" />

    <!-- Opción 2: Confirmar Ingreso -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmarIngresoPapeleria"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_primary_background"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="📥 Confirmar Ingreso (Lunes)" />

</LinearLayout>
