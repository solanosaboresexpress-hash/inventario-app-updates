<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗓️ Seleccionar Rango de Fechas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/brand_gold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Opciones rápidas -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opciones rápidas:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_gold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnUltimos7Dias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Últimos 7 días"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_background_secondary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnUltimos30Dias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Últimos 30 días"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_background_secondary"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Fechas seleccionadas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/category_content_background"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desde:"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaDesde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar fecha"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasta:"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaHasta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar fecha"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Calendario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/category_content_background"
        android:padding="8dp">

        <!-- Navegación del mes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnMesAnterior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textSize="18sp"
                android:background="@drawable/button_background_secondary"
                android:textColor="@color/white"
                android:minWidth="40dp" />

            <TextView
                android:id="@+id/txtMesActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enero 2025"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brand_gold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnMesSiguiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textSize="18sp"
                android:background="@drawable/button_background_secondary"
                android:textColor="@color/white"
                android:minWidth="40dp" />

        </LinearLayout>

        <!-- Días de la semana -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Do"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lu"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ma"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mi"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ju"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vi"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sa"
                android:textSize="12sp"
                android:textColor="@color/brand_gold"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Grid de días -->
        <LinearLayout
            android:id="@+id/layoutCalendario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_background_secondary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnAplicar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aplicar"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:background="@drawable/category_header_background"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
