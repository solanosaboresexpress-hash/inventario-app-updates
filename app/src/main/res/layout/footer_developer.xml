<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/footer_background"
    android:padding="8dp"
    android:gravity="center">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/footer_divider_color"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2025 Sabores Express"
        android:textSize="10sp"
        android:textColor="@color/footer_text_color"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desarrollado por Lucas González"
        android:textSize="9sp"
        android:textColor="@color/footer_text_color"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/txtVersionFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema de Inventario v2.1.13"
        android:textSize="8sp"
        android:textColor="@color/footer_text_color"
        android:layout_marginTop="1dp" />

</LinearLayout>
