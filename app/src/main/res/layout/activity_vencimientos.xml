<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <!-- Título con botón WhatsApp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 Vencimientos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary" />
        
        <Button
            android:id="@+id/btnWhatsApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 WhatsApp"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:background="@color/status_success"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Sección: Agregar Nuevo Lote -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕ Agregar Nuevo Lote"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Selector de Producto -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Producto:"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:textColor="?android:attr/textColorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        
        <Button
            android:id="@+id/btnProductoAnterior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:text="▲"
            android:textSize="16sp"
            android:backgroundTint="@color/status_success" />
        
        <Spinner
            android:id="@+id/spinnerProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:padding="8dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />
        
        <Button
            android:id="@+id/btnProductoSiguiente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:text="▼"
            android:textSize="16sp"
            android:backgroundTint="@color/status_success" />
    </LinearLayout>

    <!-- Campo Cantidad -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cantidad:"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:textColor="?android:attr/textColorPrimary" />

    <EditText
        android:id="@+id/edtCantidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 200"
        android:inputType="number"
        android:padding="8dp"
        android:textSize="15sp" />

    <!-- Selector de Fecha con Flechas -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha de Vencimiento:"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:textColor="?android:attr/textColorPrimary" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        
        <Button
            android:id="@+id/btnFechaAnterior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:text="◀"
            android:textSize="18sp"
            android:backgroundTint="@color/brand_gold" />
        
        <Button
            android:id="@+id/btnFechaVencimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:text="📅 Seleccionar Fecha"
            android:textSize="13sp"
            android:backgroundTint="@color/brand_gold"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />
        
        <Button
            android:id="@+id/btnFechaSiguiente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:text="▶"
            android:textSize="18sp"
            android:backgroundTint="@color/brand_gold" />
    </LinearLayout>

    <!-- Botón Agregar -->
    <Button
        android:id="@+id/btnAgregarLote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AGREGAR LOTE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/status_success" />

    <!-- Divisor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Sección: Lotes Cargados -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦 Lotes Activos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Indicador de carga -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">
        
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />
        
        <TextView
            android:id="@+id/txtLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Cargando vencimientos..."
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Lista de Lotes Cargados -->
    <ScrollView
        android:id="@+id/scrollViewLotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutLotesCargados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

</LinearLayout>
