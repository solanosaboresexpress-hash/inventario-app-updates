<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/text_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Foto/Avatar -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_background_personal"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre del empleado -->
            <TextView
                android:id="@+id/txtNombreEmpleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Apellido"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Cargo y DNI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtCargo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cargo"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtDNI"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNI: 12345678"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Certificaciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Libreta Sanitaria -->
                <LinearLayout
                    android:id="@+id/layoutLibreta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/certificacion_background"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏥"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Libreta"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtLibretaVencimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 días"
                            android:textSize="9sp"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.8" />

                    </LinearLayout>

                    <!-- Indicador de imagen cargada -->
                    <TextView
                        android:id="@+id/txtLibretaImagen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👁️"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone"
                        android:contentDescription="Imagen cargada" />

                </LinearLayout>

                <!-- Curso de Manipulación -->
                <LinearLayout
                    android:id="@+id/layoutCurso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/certificacion_background"
                    android:padding="6dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Curso"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCursoVencimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 días"
                            android:textSize="9sp"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.8" />

                    </LinearLayout>

                    <!-- Indicador de imagen cargada -->
                    <TextView
                        android:id="@+id/txtCursoImagen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👁️"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone"
                        android:contentDescription="Imagen cargada" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Botón de acciones -->
        <ImageButton
            android:id="@+id/btnAcciones"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
