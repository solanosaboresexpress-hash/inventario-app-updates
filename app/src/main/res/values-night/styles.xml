<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode (matched to web dark) -->
    <style name="Theme.InventarioApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_gold</item>
        <item name="colorPrimaryVariant">@color/brand_gold_dark</item>
        <item name="colorOnPrimary">@color/brand_black</item>
        <item name="colorSecondary">@color/brand_gold</item>
        <item name="colorSecondaryVariant">@color/brand_gold_dark</item>
        <item name="colorOnSecondary">@color/brand_black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_gold_dark</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="textInputStyle">@style/Widget.Inventario.TextInputLayout</item>
        <item name="buttonStyle">@style/Widget.Inventario.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.Inventario.Card</item>
        <item name="alertDialogTheme">@style/Theme.InventarioApp.AlertDialog</item>
    </style>
    
    <style name="Theme.InventarioApp.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_gold</item>
        <item name="colorPrimaryVariant">@color/brand_gold_dark</item>
        <item name="colorOnPrimary">@color/brand_black</item>
        <item name="colorSecondary">@color/brand_gold</item>
        <item name="colorSecondaryVariant">@color/brand_gold_dark</item>
        <item name="colorOnSecondary">@color/brand_black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_gold_dark</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="alertDialogTheme">@style/Theme.InventarioApp.AlertDialog</item>
    </style>
    
    <style name="Theme.InventarioApp.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/web_dark_bg</item>
        <item name="colorSurface">@color/web_dark_surface</item>
        <item name="android:textColorPrimary">@color/web_text_light</item>
        <item name="android:textColor">@color/web_text_light</item>
    </style>
    
    <!-- Estilos personalizados para dark mode -->
    <style name="Widget.Inventario.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/brand_black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="textAllCaps">false</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.Inventario.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/web_gold_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/brand_gold</item>
        <item name="strokeWidth">2dp</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Inventario.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_color</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeColor">@color/web_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Inventario.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/brand_gold</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/brand_gold_dark</item>
    </style>
    
    <style name="TextAppearance.Inventario.EmailSuffix" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    
    <style name="TextAppearance.Inventario.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/web_gold_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.Inventario.Subtitle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/web_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    
    <style name="TextAppearance.Inventario.SectionLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/web_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <style name="CustomButtonStyle" parent="Widget.Inventario.Button.Primary"/>
</resources>
